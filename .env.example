# ---------------------------------------------------------------------------
# Sanity — from sanity.io/manage (account: ea@cbalifestyle.com)
# The site builds and runs WITHOUT these; it falls back to placeholder copy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer token. Sanity → API → Tokens → "Read" permission.
SANITY_API_READ_TOKEN=

# Editor token. Needed only so the guest form can save applications.
SANITY_API_WRITE_TOKEN=

# Any random string. Paste the same value into the Sanity webhook secret.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Resend — guest application notifications (resend.com/api-keys)
# Without these the form still saves to Sanity; it just sends no email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
GUEST_APPLICATION_TO_EMAIL=
GUEST_APPLICATION_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Public site URL — used for metadata, OG tags and sitemap.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://leejason.net
